{
  "name": "diana-montes-app",
  "version": "1.0.0",
  "description": "App móvil de la campaña Diana Lucía Montes: simpatizantes (ingreso con WhatsApp) y equipo (panel de la campaña).",
  "private": true,
  "scripts": {
    "start": "ng serve --port 8100",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "android": "ng build --configuration production && npx cap sync android && npx cap open android",
    "ios": "ng build --configuration production && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@capacitor/android": "^7.6.0",
    "@capacitor/app": "^7.1.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.6.0",
    "@capacitor/ios": "^7.6.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@ionic/angular": "^8.8.0",
    "ionicons": "^8.0.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@capacitor/cli": "^7.6.0",
    "typescript": "~5.9.3"
  }
}
