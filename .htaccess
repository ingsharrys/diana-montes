# BEGIN cPanel-generated php ini directives, do not edit
<IfModule php8_module>
    php_value error_log "/home/dianamontes/logs/php.error.log"
    php_flag log_errors On
</IfModule>

<IfModule lsapi_module>
    php_value error_log "/home/dianamontes/logs/php.error.log"
    php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit


# BEGIN URL AMIGABLES
<IfModule mod_rewrite.c>

    RewriteEngine On

    # Excluir las peticiones a la API de las redirecciones
    RewriteRule ^(api|admin)(/|$) - [L]

    # Redireccionar las URL originales de las políticas
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+(.*/)?politicas/(privacidad|terminos|eliminar-datos)(\.php)?[\s?] [NC]
    RewriteRule ^politicas/(privacidad|terminos|eliminar-datos)(\.php)?$ $1/ [R=301,L]

    # Agregar barra final a las URL de las políticas
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteRule ^(privacidad|terminos|eliminar-datos)$ $1/ [R=301,L]

    # Cargar internamente las políticas
    RewriteRule ^privacidad/?$ politicas/privacidad.php [L]
    RewriteRule ^terminos/?$ politicas/terminos.php [L]
    RewriteRule ^eliminar-datos/?$ politicas/eliminar-datos.php [L]

    # Eliminar .php solamente en peticiones GET y HEAD
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^(.+)\.php$ $1 [R=301,L]

    # Cargar archivos PHP sin extensión
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L]

</IfModule>
# END URL AMIGABLES